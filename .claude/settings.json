{
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.pulumi/credentials.json)",
      "Read(~/.terraform.d/credentials.tfrc.json)",
      "Read(~/.kube/config)",
      "Read(~/.docker/config.json)",
      "Read(~/.claude/.credentials.json)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git -C * push *)",
      "Bash(gh pr create *)",
      "Bash(terraform apply *)",
      "Bash(terraform * apply *)",
      "Bash(terraform destroy *)",
      "Bash(terraform * destroy *)",
      "Bash(terraform import *)",
      "Bash(terraform * import *)",
      "Bash(terraform state *)",
      "Bash(terraform * state *)",
      "Bash(pulumi up *)",
      "Bash(pulumi * up *)",
      "Bash(pulumi destroy *)",
      "Bash(pulumi * destroy *)",
      "Bash(pulumi refresh *)",
      "Bash(pulumi * refresh *)",
      "Bash(pulumi import *)",
      "Bash(pulumi * import *)",
      "Bash(pulumi state *)",
      "Bash(pulumi * state *)"
    ],
    "defaultMode": "auto"
  },
  "disableClaudeAiConnectors": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.zsh"
  },
  "enabledPlugins": {
    "workmux-status@workmux": true
  },
  "extraKnownMarketplaces": {
    "workmux": {
      "source": {
        "source": "github",
        "repo": "raine/workmux"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "awaySummaryEnabled": false,
  "autoMemoryEnabled": false,
  "editorMode": "vim"
}
