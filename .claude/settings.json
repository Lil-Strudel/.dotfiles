{
  "env": {
    "DISABLE_AUTOUPDATER": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.gnupg/**)",
      "Read(~/.aws/credentials)",
      "Read(~/.config/gh/hosts.yml)",
      "Read(~/.pulumi/credentials.json)",
      "Read(~/.terraform.d/credentials.tfrc.json)",
      "Read(~/.kube/config)",
      "Read(~/.docker/config.json)",
      "Read(~/.claude/.credentials.json)"
    ],
    "ask": [
      "Bash(git push *)",
      "Bash(git -C * push *)",
      "Bash(gh pr create *)",
      "Bash(terraform apply *)",
      "Bash(terraform * apply *)",
      "Bash(terraform destroy *)",
      "Bash(terraform * destroy *)",
      "Bash(terraform import *)",
      "Bash(terraform * import *)",
      "Bash(terraform state *)",
      "Bash(terraform * state *)",
      "Bash(pulumi up *)",
      "Bash(pulumi * up *)",
      "Bash(pulumi destroy *)",
      "Bash(pulumi * destroy *)",
      "Bash(pulumi refresh *)",
      "Bash(pulumi * refresh *)",
      "Bash(pulumi import *)",
      "Bash(pulumi * import *)",
      "Bash(pulumi state *)",
      "Bash(pulumi * state *)",
      "mcp__plugin_atlassian_atlassian__addGraphContext",
      "mcp__plugin_atlassian_atlassian__addOrEditJiraIssueComment",
      "mcp__plugin_atlassian_atlassian__createConfluenceContent",
      "mcp__plugin_atlassian_atlassian__createJiraIssue",
      "mcp__plugin_atlassian_atlassian__editJiraIssue",
      "mcp__plugin_atlassian_atlassian__executeDestructive",
      "mcp__plugin_atlassian_atlassian__executeWrite",
      "mcp__plugin_atlassian_atlassian__transitionJiraIssue",
      "mcp__plugin_atlassian_atlassian__updateConfluenceContent",
      "mcp__plugin_slack_slack__slack_add_list_record",
      "mcp__plugin_slack_slack__slack_add_reaction",
      "mcp__plugin_slack_slack__slack_complete_file_upload",
      "mcp__plugin_slack_slack__slack_create_canvas",
      "mcp__plugin_slack_slack__slack_create_conversation",
      "mcp__plugin_slack_slack__slack_create_list",
      "mcp__plugin_slack_slack__slack_schedule_message",
      "mcp__plugin_slack_slack__slack_send_message",
      "mcp__plugin_slack_slack__slack_send_message_draft",
      "mcp__plugin_slack_slack__slack_update_canvas",
      "mcp__plugin_slack_slack__slack_update_list",
      "mcp__plugin_slack_slack__slack_update_list_record"
    ],
    "defaultMode": "auto"
  },
  "disableClaudeAiConnectors": true,
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.zsh"
  },
  "enabledPlugins": {
    "workmux-status@workmux": true,
    "atlassian@claude-plugins-official": true,
    "slack@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "workmux": {
      "source": {
        "source": "github",
        "repo": "raine/workmux"
      }
    }
  },
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "high"
    }
  },
  "awaySummaryEnabled": false,
  "autoMemoryEnabled": false,
  "editorMode": "vim"
}
